class _RainNow extends StatelessWidget {
  const _RainNow({required this.snapshot});
  final WeatherSnapshot snapshot;
  @override
  Widget build(BuildContext context) {
    final c = snapshot.current;
    final items = snapshot.minutely.take(6).toList();
    return GlassCard(
      padding: const EdgeInsets.all(14),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Icon(isRainCode(c.weatherCode) ? Icons.water_drop_rounded : Icons.cloud_outlined, color: appBlue),
              const SizedBox(width: 7),
              Expanded(
                child: Text(
                  c.precipitation > .02 ? currentWeatherText(c) : 'بارش لحظه‌ای قابل توجه ثبت نشده',
                  style: const TextStyle(fontFamily: 'Nazanin', fontSize: 18, fontWeight: FontWeight.w700),
                ),
              ),
              Text(
                '${faDigits(c.precipitation.toStringAsFixed(2))} mm',
                textDirection: TextDirection.ltr,
                style: const TextStyle(fontFamily: 'Titr', color: appBlue),
              ),
            ],
          ),
          if (items.isNotEmpty) ...[
            const SizedBox(height: 11),
            SizedBox(
              height: 63,
              child: ListView.separated(
                scrollDirection: Axis.horizontal,
                itemCount: items.length,
                separatorBuilder: (_, __) => const SizedBox(width: 7),
                itemBuilder: (_, i) {
                  final m = items[i];
                  return Container(
                    width: 66,
                    padding: const EdgeInsets.symmetric(vertical: 6),
                    decoration: BoxDecoration(
                      color: const Color(0xFFEAF6FD),
                      borderRadius: BorderRadius.circular(16),
                    ),
                    child: Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        Text(formatClock(m.time), style: const TextStyle(fontSize: 10, color: appMuted)),
                        const SizedBox(height: 2),
                        Text('${faDigits(m.precipitation.toStringAsFixed(1))} mm', textDirection: TextDirection.ltr, style: const TextStyle(fontSize: 10, fontWeight: FontWeight.w800)),
                      ],
                    ),
                  );
                },
              ),
            ),
          ],
        ],
      ),
    );
  }
}

class _Metric extends StatelessWidget {
  const _Metric(this.icon, this.label, this.value, this.color);
  final IconData icon;
  final String label;
  final String value;
  final Color color;
  @override
  Widget build(BuildContext context) => GlassCard(
        radius: 21,
        padding: const EdgeInsets.symmetric(vertical: 13, horizontal: 8),
        child: Column(
          children: [
            Icon(icon, color: color, size: 23),
            const SizedBox(height: 5),
            Text(value, textDirection: TextDirection.ltr, style: const TextStyle(fontFamily: 'Titr', fontSize: 16)),
            Text(label, style: const TextStyle(fontFamily: 'Nazanin', color: appMuted, fontSize: 14)),
          ],
        ),
      );
}

class _Hours extends StatelessWidget {
  const _Hours({required this.items});
  final List<HourlyWeather> items;
  @override
  Widget build(BuildContext context) => GlassCard(
        padding: const EdgeInsets.all(14),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text('ساعت‌های آینده', style: TextStyle(fontFamily: 'Titr', fontSize: 17)),
            const SizedBox(height: 10),
            SizedBox(
              height: 100,
              child: ListView.separated(
                scrollDirection: Axis.horizontal,
                itemCount: items.length > 10 ? 10 : items.length,
                separatorBuilder: (_, __) => const SizedBox(width: 7),
                itemBuilder: (_, i) {
                  final h = items[i];
                  return Container(
                    width: 65,
                    decoration: BoxDecoration(
                      color: i == 0 ? appBlue.withValues(alpha: .1) : const Color(0xFFF1F7FB),
                      borderRadius: BorderRadius.circular(19),
                    ),
                    child: Column(
                      mainAxisAlignment: MainAxisAlignment.spaceEvenly,
                      children: [
                        Text(i == 0 ? 'اکنون' : formatClock(h.time), style: const TextStyle(fontSize: 10, color: appMuted)),
                        Icon(weatherIcon(h.weatherCode), size: 22, color: weatherAccent(h.weatherCode)),
                        Text(formatTemp(h.temperature), style: const TextStyle(fontFamily: 'Titr', fontSize: 14)),
                        Text('${faDigits(h.precipitationProbability)}٪', style: const TextStyle(fontSize: 9, color: appBlue)),
                      ],
                    ),
                  );
                },
              ),
            ),
          ],
        ),
      );
}

class _Hourly extends StatelessWidget {
  const _Hourly({super.key, required this.snapshot});
  final WeatherSnapshot snapshot;
  @override
  Widget build(BuildContext context) => ListView.separated(
        padding: const EdgeInsets.fromLTRB(16, 8, 16, 20),
        itemCount: snapshot.hourly.length,
        separatorBuilder: (_, __) => const SizedBox(height: 8),
        itemBuilder: (_, i) {
          final h = snapshot.hourly[i];
          return GlassCard(
            radius: 20,
            padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 12),
            child: Row(
              children: [
                SizedBox(width: 55, child: Text(i == 0 ? 'اکنون' : formatClock(h.time), style: const TextStyle(fontFamily: 'Titr'))),
                Icon(weatherIcon(h.weatherCode), color: weatherAccent(h.weatherCode)),
                const SizedBox(width: 9),
                Expanded(child: Text(weatherTitle(h.weatherCode), style: const TextStyle(fontFamily: 'Nazanin', fontSize: 16))),
                Text('${faDigits(h.precipitationProbability)}٪', style: const TextStyle(color: appBlue, fontSize: 11)),
                const SizedBox(width: 10),
                Text(formatTemp(h.temperature), style: const TextStyle(fontFamily: 'Titr', fontSize: 18)),
              ],
            ),
          );
        },
      );
}

class _Daily extends StatelessWidget {
  const _Daily({super.key, required this.snapshot});
  final WeatherSnapshot snapshot;
  @override
  Widget build(BuildContext context) => ListView.separated(
        padding: const EdgeInsets.fromLTRB(16, 8, 16, 20),
        itemCount: snapshot.daily.length,
        separatorBuilder: (_, __) => const SizedBox(height: 8),
        itemBuilder: (_, i) {
          final d = snapshot.daily[i];
          return GlassCard(
            radius: 20,
            padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 13),
            child: Row(
              children: [
                SizedBox(width: 72, child: Text(i == 0 ? 'امروز' : shortWeekday(d.date), style: const TextStyle(fontFamily: 'Titr'))),
                Icon(weatherIcon(d.weatherCode), color: weatherAccent(d.weatherCode)),
                const SizedBox(width: 9),
                Expanded(child: Text(weatherTitle(d.weatherCode), style: const TextStyle(fontFamily: 'Nazanin', fontSize: 16))),
                Text('${faDigits(d.precipitationProbability)}٪', style: const TextStyle(color: appBlue, fontSize: 11)),
                const SizedBox(width: 9),
                Text('${formatTemp(d.minTemperature)} / ${formatTemp(d.maxTemperature)}', textDirection: TextDirection.ltr, style: const TextStyle(fontFamily: 'Titr')),
              ],
            ),
          );
        },
      );
}

class _Details extends StatelessWidget {
  const _Details({super.key, required this.snapshot, required this.gps, required this.search});
  final WeatherSnapshot snapshot;
  final VoidCallback gps;
  final VoidCallback search;
