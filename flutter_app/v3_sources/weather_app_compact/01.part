                  ? const _Loading()
                  : s == null
                      ? _NoLocation(
                          message: _message,
                          gps: () => _useGps(),
                          search: _openSearch,
                        )
                      : Column(
                          children: [
                            _Header(
                              snapshot: s,
                              refreshing: _refreshing,
                              refresh: () => _refreshWeather(),
                              search: _openSearch,
                              gps: () => _useGps(),
                            ),
                            if (_message != null)
                              Padding(
                                padding: const EdgeInsets.fromLTRB(16, 0, 16, 6),
                                child: GlassCard(
                                  radius: 16,
                                  padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                                  child: Row(
                                    children: [
                                      const Icon(Icons.info_outline_rounded, size: 18, color: appBlue),
                                      const SizedBox(width: 7),
                                      Expanded(
                                        child: Text(
                                          _message!,
                                          style: const TextStyle(fontFamily: 'Nazanin', fontSize: 15),
                                        ),
                                      ),
                                    ],
                                  ),
                                ),
                              ),
                            Expanded(
                              child: AnimatedSwitcher(
                                duration: 320.ms,
                                child: switch (_tab) {
                                  1 => _Hourly(key: const ValueKey(1), snapshot: s),
                                  2 => _Daily(key: const ValueKey(2), snapshot: s),
                                  3 => _Details(
                                      key: const ValueKey(3),
                                      snapshot: s,
                                      gps: () => _useGps(),
                                      search: _openSearch,
                                    ),
                                  _ => _Home(
                                      key: const ValueKey(0),
                                      snapshot: s,
                                      refresh: () => _refreshWeather(),
                                    ),
                                },
                              ),
                            ),
                            _Nav(index: _tab, changed: (v) => setState(() => _tab = v)),
                          ],
                        ),
            ),
          ],
        ),
      ),
    );
  }
}

class _Header extends StatelessWidget {
  const _Header({
    required this.snapshot,
    required this.refreshing,
    required this.refresh,
    required this.search,
    required this.gps,
  });
  final WeatherSnapshot snapshot;
  final bool refreshing;
  final VoidCallback refresh;
  final VoidCallback search;
  final VoidCallback gps;

  @override
  Widget build(BuildContext context) => Padding(
        padding: const EdgeInsets.fromLTRB(16, 7, 16, 7),
        child: Row(
          children: [
            _Circle(icon: Icons.search_rounded, onTap: search),
            const Spacer(),
            GestureDetector(
              onTap: gps,
              child: Column(
                children: [
                  Row(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      const Icon(Icons.location_on_rounded, color: appBlue, size: 19),
                      const SizedBox(width: 3),
                      Text(
                        snapshot.location.label,
                        style: const TextStyle(fontFamily: 'Titr', fontSize: 20, color: appInk),
                      ),
                    ],
                  ),
                  Text(
                    shamsiDate(DateTime.now()),
                    style: const TextStyle(fontFamily: 'Nazanin', color: appMuted, fontSize: 15),
                  ),
                ],
              ),
            ),
            const Spacer(),
            _Circle(
              icon: refreshing ? Icons.sync_rounded : Icons.refresh_rounded,
              onTap: refreshing ? null : refresh,
            ),
          ],
        ),
      );
}

class _Circle extends StatelessWidget {
  const _Circle({required this.icon, required this.onTap});
  final IconData icon;
  final VoidCallback? onTap;
  @override
  Widget build(BuildContext context) => Material(
        color: Colors.white.withValues(alpha: .78),
        borderRadius: BorderRadius.circular(15),
        child: InkWell(
          onTap: onTap,
          borderRadius: BorderRadius.circular(15),
          child: SizedBox(width: 44, height: 44, child: Icon(icon, color: appInk)),
        ),
      );
}

class _Home extends StatelessWidget {
  const _Home({super.key, required this.snapshot, required this.refresh});
  final WeatherSnapshot snapshot;
  final Future<void> Function() refresh;

  @override
  Widget build(BuildContext context) {
    final c = snapshot.current;
    final width = MediaQuery.sizeOf(context).width;
    final clockSize = (width - 58).clamp(278.0, 326.0).toDouble();

    return RefreshIndicator(
      onRefresh: refresh,
      child: ListView(
        physics: const AlwaysScrollableScrollPhysics(parent: BouncingScrollPhysics()),
        padding: const EdgeInsets.fromLTRB(16, 4, 16, 16),
        children: [
          GlassCard(
            radius: 31,
            padding: const EdgeInsets.fromLTRB(12, 14, 12, 13),
            child: Column(
              children: [
                Row(
                  children: [
                    Container(
                      width: 52,
                      height: 52,
                      decoration: BoxDecoration(
                        color: weatherAccent(c.weatherCode, isDay: c.isDay).withValues(alpha: .12),
                        borderRadius: BorderRadius.circular(17),
                      ),
                      child: Icon(
                        weatherIcon(c.weatherCode, isDay: c.isDay),
                        size: 31,
                        color: weatherAccent(c.weatherCode, isDay: c.isDay),
                      ),
                    )
                        .animate(onPlay: (controller) => controller.repeat(reverse: true))
                        .scale(
                          begin: const Offset(.96, .96),
                          end: const Offset(1.06, 1.06),
                          duration: 1700.ms,
                        ),
                    const SizedBox(width: 10),
                    Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Text(
                            currentWeatherText(c),
                            maxLines: 2,
                            overflow: TextOverflow.ellipsis,
                            style: const TextStyle(
                              fontFamily: 'Nazanin',
                              fontSize: 19,
                              fontWeight: FontWeight.w700,
                              height: 1.15,
                            ),
                          ),
                          const SizedBox(height: 2),
                          Text(
                            'حس می‌شود ${formatTemp(c.apparentTemperature)}',
                            style: const TextStyle(
                              fontFamily: 'Vazir',
                              color: appMuted,
                              fontSize: 11,
                            ),
                          ),
                        ],
                      ),
                    ),
                    Text(
                      formatTemp(c.temperature),
                      textDirection: TextDirection.ltr,
                      style: const TextStyle(
                        fontFamily: 'Titr',
                        fontSize: 40,
                        height: 1,
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 4),
                V4WeatherClock(
                  snapshot: snapshot,
                  size: clockSize,
                ),
              ],
            ),
          ).animate().fadeIn(duration: 400.ms).slideY(begin: .025, end: 0),
          const SizedBox(height: 10),
          Row(
            children: [
              Expanded(
                child: _Metric(
                  Icons.air_rounded,
                  'سرعت باد km/h',
                  '${faDigits(c.windSpeed.round())}',
                  const Color(0xFF4C9CA8),
                ),
              ),
              const SizedBox(width: 9),
              Expanded(
                child: _Metric(
                  Icons.speed_rounded,
                  'فشار هوا hPa',
                  '${faDigits(c.pressure.round())}',
                  const Color(0xFF6E7EDB),
                ),
              ),
            ],
          ).animate().fadeIn(delay: 110.ms),
          const SizedBox(height: 8),
          Text(
            'آخرین بروزرسانی ${formatClock(snapshot.fetchedAt)}',
            textAlign: TextAlign.center,
            style: const TextStyle(
              fontFamily: 'Nazanin',
              color: appMuted,
              fontSize: 14,
            ),
          ),
        ],
      ),
    );
  }
}

