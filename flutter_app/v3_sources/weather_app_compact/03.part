              _Line('ابر', '${faDigits(c.cloudCover)}٪'),
              _Line('بارش فعلی', '${faDigits(c.precipitation.toStringAsFixed(2))} mm'),
              _Line('جهت باد', '${faDigits(c.windDirection.round())}°'),
              if (today != null) ...[
                _Line('طلوع', formatClock(today.sunrise)),
                _Line('غروب', formatClock(today.sunset)),
              ],
            ],
          ),
        ),
      ],
    );
  }
}

class _Line extends StatelessWidget {
  const _Line(this.label, this.value);
  final String label;
  final String value;
  @override
  Widget build(BuildContext context) => Padding(
        padding: const EdgeInsets.symmetric(vertical: 8),
        child: Row(
          children: [
            Expanded(child: Text(label, style: const TextStyle(fontFamily: 'Nazanin', fontSize: 17, color: appMuted))),
            Text(value, textDirection: TextDirection.ltr, style: const TextStyle(fontFamily: 'Titr')),
          ],
        ),
      );
}

