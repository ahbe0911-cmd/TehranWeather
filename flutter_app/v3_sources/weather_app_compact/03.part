class _Loading extends StatelessWidget {
  const _Loading();
  @override
  Widget build(BuildContext context) => Center(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            const Icon(Icons.my_location_rounded, size: 52, color: appBlue)
                .animate(onPlay: (c) => c.repeat())
                .rotate(duration: 1500.ms),
            const SizedBox(height: 13),
            const Text('هواشناسی زنده در حال آماده‌سازی است…', style: TextStyle(fontFamily: 'Titr', fontSize: 18)),
          ],
